digraph RastreioArvore {
  rankdir=TB;
    graph [ordering="out"];
  label="Rastreio de Execução da Árvore";
  labelloc="t";
  fontsize=16;
  node [shape=circle, fontname="Helvetica", fontsize=10];

  subgraph cluster_passo_1 {
    label="Passo 1: Inserção das chaves 10 e 5 (Balanceada)";
    color="#cbd5e1"; style="rounded";
    "10_p1" [label="10\nFB:0"];
    "10_p1" -> "5_p1";
    "5_p1" [label="5\nFB:0", style=filled, fillcolor="#fde047", penwidth=2.0];
    "null_r_10_p1" [style=invis];
    "10_p1" -> "null_r_10_p1" [style=invis];
  }

  subgraph cluster_passo_2 {
    label="Passo 2: Inserção da chave 8 (Rotação para a direita)";
    color="#cbd5e1"; style="rounded";
    "8_p2" [label="8\nFB:0", style=filled, fillcolor="#fde047", penwidth=2.0];
    "8_p2" -> "5_p2";
    "5_p2" [label="5\nFB:0"];
    "8_p2" -> "10_p2";
    "10_p2" [label="10\nFB:0"];
  }

  subgraph cluster_passo_3 {
    label="Passo 3: Inserção das chaves 16, -8, 56 (Rotação para a esquerda)";
    color="#cbd5e1"; style="rounded";
    "8_p3" [label="8\nFB:0"];
    "8_p3" -> "5_p3";
    "5_p3" [label="5\nFB:0"];
    "5_p3" -> "-8_p3";
    "-8_p3" [label="-8\nFB:0"];
    "null_r_5_p3" [style=invis];
    "5_p3" -> "null_r_5_p3" [style=invis];
    "8_p3" -> "16_p3";
    "16_p3" [label="16\nFB:0"];
    "16_p3" -> "10_p3";
    "10_p3" [label="10\nFB:0"];
    "16_p3" -> "56_p3";
    "56_p3" [label="56\nFB:0", style=filled, fillcolor="#fde047", penwidth=2.0];
  }

  subgraph cluster_passo_4 {
    label="Passo 4: Estado após a inserção de todas as chaves";
    color="#cbd5e1"; style="rounded";
    "8_p4" [label="8\nFB:0"];
    "8_p4" -> "5_p4";
    "5_p4" [label="5\nFB:0"];
    "5_p4" -> "-8_p4";
    "-8_p4" [label="-8\nFB:0"];
    "5_p4" -> "6_p4";
    "6_p4" [label="6\nFB:0"];
    "8_p4" -> "16_p4";
    "16_p4" [label="16\nFB:0"];
    "16_p4" -> "10_p4";
    "10_p4" [label="10\nFB:0"];
    "16_p4" -> "56_p4";
    "56_p4" [label="56\nFB:0"];
  }

  subgraph cluster_passo_5 {
    label="Passo 5: Inserção das chaves 100 e 150 (Rotação para a esquerda)";
    color="#cbd5e1"; style="rounded";
    "8_p5" [label="8\nFB:-1"];
    "8_p5" -> "5_p5";
    "5_p5" [label="5\nFB:0"];
    "5_p5" -> "-8_p5";
    "-8_p5" [label="-8\nFB:0"];
    "5_p5" -> "6_p5";
    "6_p5" [label="6\nFB:0"];
    "8_p5" -> "16_p5";
    "16_p5" [label="16\nFB:-1"];
    "16_p5" -> "10_p5";
    "10_p5" [label="10\nFB:0"];
    "16_p5" -> "100_p5";
    "100_p5" [label="100\nFB:0"];
    "100_p5" -> "56_p5";
    "56_p5" [label="56\nFB:0"];
    "100_p5" -> "150_p5";
    "150_p5" [label="150\nFB:0", style=filled, fillcolor="#fde047", penwidth=2.0];
  }

  subgraph cluster_passo_6 {
    label="Passo 6: Remoção do 8 (Busca pelo sucessor e rebalanceamento dos nós ancestrais)";
    color="#cbd5e1"; style="rounded";
    "10_p6" [label="10\nFB:-1", style=filled, fillcolor="#fde047", penwidth=2.0];
    "10_p6" -> "5_p6";
    "5_p6" [label="5\nFB:0"];
    "5_p6" -> "-8_p6";
    "-8_p6" [label="-8\nFB:0"];
    "5_p6" -> "6_p6";
    "6_p6" [label="6\nFB:0"];
    "10_p6" -> "100_p6";
    "100_p6" [label="100\nFB:1"];
    "100_p6" -> "16_p6";
    "16_p6" [label="16\nFB:0"];
    "null_l_16_p6" [style=invis];
    "16_p6" -> "null_l_16_p6" [style=invis];
    "16_p6" -> "56_p6";
    "56_p6" [label="56\nFB:0"];
    "100_p6" -> "150_p6";
    "150_p6" [label="150\nFB:0"];
  }

}
